{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.flows-list.request.schema.json",
  "title": "flows-list request",
  "description": "Request headers: team (decimal team_id), operator_id, request_id, optional team_name. Backs GET /ui/v1/flows.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "model_alias": {
          "$ref": "defs.schema.json#/$defs/modelAlias"
        }
      }
    }
  }
}
