{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.flows-list.reply.schema.json",
  "title": "flows-list reply",
  "description": "Status 200. Flows of the verified team ordered by (created_at, flow_id).",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "next_cursor"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/flow"
      }
    },
    "next_cursor": {
      "type": ["string", "null"]
    }
  }
}
