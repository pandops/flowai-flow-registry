{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.flow-replace.request.schema.json",
  "title": "flow-replace request",
  "description": "Request headers: team (decimal team_id), operator_id, request_id, optional team_name. Request header If-Match \"<revision>\" is required. Backs PUT /ui/v1/flows/{flow_id}.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flow_id": {
          "$ref": "defs.schema.json#/$defs/id"
        }
      },
      "required": ["flow_id"]
    },
    "body": {
      "$ref": "defs.schema.json#/$defs/flowWriteBody"
    }
  },
  "required": ["params", "body"]
}
