{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service.targets.reply.schema.json",
  "title": "targets reply",
  "description": "Status 200 with every bound Flow and its current execution revision, or 404 not_found when the team has no binding for the Source (foreign Sources look the same).",
  "type": "object",
  "additionalProperties": false,
  "required": ["team_id", "source_id", "flows"],
  "properties": {
    "team_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "source_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "execution_revision"],
        "properties": {
          "flow_id": {
            "$ref": "defs.schema.json#/$defs/id"
          },
          "execution_revision": {
            "$ref": "defs.schema.json#/$defs/executionRevision"
          }
        }
      }
    }
  }
}
