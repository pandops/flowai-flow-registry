{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.reply.schema.json",
  "title": "error reply",
  "description": "Body of every non-2xx reply; the status travels in the NATS reply header 'status'. request_id is absent only when the request carried no valid request_id header.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "flows": {
      "description": "Only on 409 model_last_in_flow from retire-alias.",
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/flowRef"
      }
    }
  }
}
